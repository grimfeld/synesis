{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synesis",
  "version": "0.0.21",
  "identifier": "tech.grimfeld.synesis",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Synesis",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://*.tile.openstreetmap.org https://tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://*.tile.openstreetmap.org"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "grimfeld",
    "copyright": "Copyright © 2026 grimfeld. Free software under the GNU AGPL-3.0.",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "frameworks": ["SystemConfiguration", "Network", "CoreFoundation"]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/grimfeld/synesis/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFQ0E2MTNFOTY5MUUxRjcKUldUMzRaR1dQbUhLTG1oU0VwbmwrMWxVdGd6WE16dS95OHB3a1cwR1JweFE3TXdySTdHRjBvd3EK",
      "windows": { "installMode": "passive" }
    }
  }
}
