{
  "readyLabel": "ready-for-agent",
  "branchRegex": "^(\\d+)(?=[-_/]|$)|(?:^|[-_/])(?:issues?|tickets?|spec|gh|fix|bug|feat|feature)[-_/]?(\\d+)(?=[-_/]|$)",
  "integrationBranchPrefix": "integration/",
  "exclude": {
    "authors": [
      "dependabot"
    ],
    "branches": [
      "dependabot/"
    ]
  },
  "autonomy": {
    "fullMaxFollowUps": 1,
    "fullMinClaudeCommitShare": 1
  },
  "publish": "full",
  "ciWorkflow": ".github/workflows/ci.yml"
}
