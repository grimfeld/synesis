{
  "name": "synesis",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.25",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "setup": "node scripts/dev.mjs --no-start",
    "dev:all": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:web": "node scripts/build-web.mjs",
    "dev:web": "node scripts/build-web.mjs --engine && vite --mode web",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open --e2e",
    "prepare": "husky",
    "check": "npm run typecheck && npm run test:unit && cargo clippy --workspace --all-targets -- -D warnings",
    "release": "node scripts/release.mjs",
    "icons": "tauri icon branding/icon-manifest.json && node scripts/flatten-ios-icons.mjs",
    "icons:mobile": "node scripts/sync-mobile-icons.mjs",
    "licenses": "node scripts/licenses.mjs",
    "android:post-init": "node scripts/sync-mobile-icons.mjs && node scripts/android-post-init.mjs",
    "ios:post-init": "node scripts/sync-mobile-icons.mjs && node scripts/ios-post-init.mjs",
    "skins:index": "vite-node scripts/skins-index.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-barcode-scanner": "^2.5.3",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.14.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "d3-force": "^3.0.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.71.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2",
    "@types/d3-force": "^3.0.10",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "cypress": "^16.2.1",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "playwright-core": "^1.65.0",
    "pngjs": "^7.0.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.5",
    "vite-node": "^3.2.4",
    "vitest": "^5.1.0"
  }
}
