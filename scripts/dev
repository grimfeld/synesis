#!/usr/bin/env bash
# One-shot developer setup for Synesis: installs the toolchain, fetches
# dependencies, verifies the build, then starts `npm run tauri dev`.
# Works on macOS, Linux, and Windows (Git Bash; `scripts\dev` from cmd or
# PowerShell goes through scripts/dev.cmd, which finds or installs Git Bash).
#
# Usage:
#   scripts/dev              # set up, then start the dev app
#   scripts/dev --no-start   # set up only (CI, first clone, new machine)
#   scripts/dev --skip-tests # set up and start without running engine tests
#
# Re-running is safe: every step checks before it installs.
#
# What "started" means: `npm run tauri dev` runs Vite on http://localhost:1420,
# opens the Tauri window, and (debug builds only) serves the engine over the
# HTTP dev bridge on 127.0.0.1:4321 so a plain browser or scripts/ui-smoke.mjs
# can drive the UI without the Tauri window.

set -euo pipefail

MIN_NODE_MAJOR=22          # scripts/ui-smoke.mjs uses the built-in WebSocket (Node 22+)
VITE_PORT=1420
BRIDGE_PORT=4321

START=1
RUN_TESTS=1
for arg in "$@"; do
  case "$arg" in
    --no-start)   START=0 ;;
    --skip-tests) RUN_TESTS=0 ;;
    -h|--help)    sed -n '2,17p' "$0"; exit 0 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

cd "$(dirname "$0")/.."

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m ✓ \033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m ! \033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m ✗ \033[0m %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

case "$(uname -s)" in
  Darwin)                 OS=macos ;;
  Linux)                  OS=linux ;;
  MINGW*|MSYS*|CYGWIN*)   OS=windows ;;
  *) die "Unsupported OS '$(uname -s)'. See https://v2.tauri.app/start/prerequisites/" ;;
esac

# --------------------------------------------------------------------- windows
# Everything on Windows installs through winget (bundled with Windows 10/11).
# Installers may show a UAC prompt. The current shell's PATH does not see new
# installs, so the known install directories are added to PATH explicitly.
if [ "$OS" = windows ]; then
  have winget || die "winget not found. Install 'App Installer' from the Microsoft Store, then re-run."
  winget_install() {  # winget_install <package id> [installer override args]
    if [ $# -ge 2 ]; then
      winget install --id "$1" --exact --silent --accept-package-agreements --accept-source-agreements --override "$2"
    else
      winget install --id "$1" --exact --silent --accept-package-agreements --accept-source-agreements
    fi
  }
  win_home="$(cygpath -u "${USERPROFILE:-$HOME}")"
  win_pf="$(cygpath -u "${PROGRAMFILES:-C:/Program Files}")"
  # bash cannot expand a variable named "ProgramFiles(x86)"; ask cmd for it.
  win_pf86="$(cygpath -u "$(cmd //c 'echo %ProgramFiles(x86)%' 2>/dev/null | tr -d '\r')")"
  [ -d "$win_pf86" ] || win_pf86="/c/Program Files (x86)"
  export PATH="$win_home/.cargo/bin:$win_pf/nodejs:$PATH"
fi

# ---------------------------------------------------------------- platform deps
log "Platform prerequisites ($OS)"
case "$OS" in
  macos)
    if xcode-select -p >/dev/null 2>&1; then
      ok "Xcode Command Line Tools"
    else
      warn "Xcode Command Line Tools missing; launching the installer."
      xcode-select --install || true
      die "Finish the Command Line Tools installation, then re-run this script."
    fi
    ;;
  linux)
    # Tauri 2 system libraries: https://v2.tauri.app/start/prerequisites/#linux
    if have apt-get; then
      sudo apt-get update -qq
      sudo apt-get install -y -qq libwebkit2gtk-4.1-dev build-essential curl wget file \
        libxdo-dev libssl-dev libayatana-appindicator3-dev librsvg2-dev
    elif have dnf; then
      sudo dnf install -y webkit2gtk4.1-devel openssl-devel curl wget file \
        libappindicator-gtk3-devel librsvg2-devel libxdo-devel
      sudo dnf group install -y "C Development Tools and Libraries"
    elif have pacman; then
      sudo pacman -S --needed --noconfirm webkit2gtk-4.1 base-devel curl wget file \
        openssl appmenu-gtk-module libappindicator-gtk3 librsvg xdotool
    else
      warn "Unknown Linux distribution; install the Tauri prerequisites manually:"
      warn "https://v2.tauri.app/start/prerequisites/#linux"
    fi
    ok "Tauri system libraries"
    ;;
  windows)
    # Tauri 2 on Windows: https://v2.tauri.app/start/prerequisites/#windows
    # 1. MSVC C++ build tools (rustc's default Windows target is *-pc-windows-msvc)
    vswhere="$win_pf86/Microsoft Visual Studio/Installer/vswhere.exe"
    have_msvc() {
      [ -x "$vswhere" ] && [ -n "$("$vswhere" -products '*' -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath 2>/dev/null)" ]
    }
    if have_msvc; then
      ok "MSVC C++ build tools"
    else
      warn "MSVC C++ build tools missing; installing Visual Studio Build Tools (several GB, takes a while)."
      winget_install Microsoft.VisualStudio.BuildTools "--quiet --wait --norestart --add Microsoft.VisualStudio.Workload.VCTools --includeRecommended"
      have_msvc || die "MSVC build tools still not detected. Open a new terminal and re-run; if it persists, add the 'Desktop development with C++' workload in the Visual Studio Installer."
      ok "MSVC C++ build tools"
    fi
    # 2. WebView2 runtime (ships with Windows 11 and Edge; missing on some Windows 10 / Server images)
    webview2_key='Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}'
    have_webview2() {
      reg query "HKLM\\SOFTWARE\\WOW6432Node\\$webview2_key" //v pv >/dev/null 2>&1 ||
      reg query "HKCU\\Software\\$webview2_key" //v pv >/dev/null 2>&1
    }
    if have_webview2; then
      ok "WebView2 runtime"
    else
      warn "WebView2 runtime missing; installing."
      winget_install Microsoft.EdgeWebView2Runtime
      ok "WebView2 runtime"
    fi
    ;;
esac

# ------------------------------------------------------------------------ Rust
log "Rust toolchain"
if ! have rustup; then
  warn "rustup not found; installing stable Rust"
  if [ "$OS" = windows ]; then
    winget_install Rustlang.Rustup
  else
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
  fi
fi
# shellcheck disable=SC1091
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
have cargo || die "cargo is still not on PATH; open a new terminal and re-run."
rustup toolchain list | grep -q '^stable' || rustup toolchain install stable --profile minimal
ok "$(rustc -V)"

# ------------------------------------------------------------------------ Node
log "Node.js >= $MIN_NODE_MAJOR"
node_major() { node -v 2>/dev/null | sed -E 's/^v([0-9]+).*/\1/'; }
if ! have node || [ "$(node_major)" -lt "$MIN_NODE_MAJOR" ]; then
  if have fnm; then
    fnm install "$MIN_NODE_MAJOR" && fnm use "$MIN_NODE_MAJOR"
  elif have nvm; then
    nvm install "$MIN_NODE_MAJOR" && nvm use "$MIN_NODE_MAJOR"
  elif [ "$OS" = windows ]; then
    winget_install OpenJS.NodeJS.LTS
  elif [ "$OS" = macos ] && have brew; then
    brew install node
  else
    warn "Installing fnm (Fast Node Manager) to provide Node $MIN_NODE_MAJOR"
    curl -fsSL https://fnm.vercel.app/install | bash -s -- --skip-shell
    export PATH="$HOME/.local/share/fnm:$HOME/.fnm:$PATH"
    eval "$(fnm env)"
    fnm install "$MIN_NODE_MAJOR" && fnm use "$MIN_NODE_MAJOR"
  fi
fi
have node || die "node is still not on PATH; open a new terminal and re-run."
[ "$(node_major)" -ge "$MIN_NODE_MAJOR" ] || die "Node $(node -v) is too old; need >= $MIN_NODE_MAJOR."
ok "node $(node -v), npm $(npm -v)"

# ---------------------------------------------------------------- dependencies
log "npm dependencies"
if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi
ok "node_modules"

log "Cargo dependencies"
cargo fetch --quiet
ok "crates fetched"

# ---------------------------------------------------------------------- verify
log "Verifying the build"
npm run --silent typecheck
ok "UI typechecks"
if [ "$RUN_TESTS" = 1 ]; then
  cargo test -p engine --quiet
  ok "engine tests pass"
else
  cargo build -p engine --quiet
  ok "engine builds (tests skipped)"
fi

# --------------------------------------------------------------------- optional
chrome_found=0
case "$OS" in
  macos)   [ -d "/Applications/Google Chrome.app" ] && chrome_found=1 ;;
  linux)   { have google-chrome || have chromium; } && chrome_found=1 ;;
  windows)
    for c in "$win_pf" "$win_pf86" "$(cygpath -u "${LOCALAPPDATA:-C:/nonexistent}")"; do
      [ -f "$c/Google/Chrome/Application/chrome.exe" ] && chrome_found=1
    done
    ;;
esac
if [ "$chrome_found" = 1 ]; then
  ok "Google Chrome found (needed only by scripts/ui-smoke.mjs)"
else
  warn "Google Chrome not found; scripts/ui-smoke.mjs will not work until it is installed."
fi

# ----------------------------------------------------------------------- start
[ "$START" = 1 ] || { log "Setup complete. Start the app with: npm run tauri dev"; exit 0; }

port_busy() {  # "localhost" rather than 127.0.0.1: Vite binds ::1 only on Windows
  if have lsof; then lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
  else (exec 3<>"/dev/tcp/localhost/$1") >/dev/null 2>&1; fi
}
for p in "$VITE_PORT" "$BRIDGE_PORT"; do
  if port_busy "$p"; then
    die "Port $p is already in use. A dev app is probably running; stop it or open http://localhost:$VITE_PORT."
  fi
done

log "Starting the dev app"
echo "    Vite UI:     http://localhost:$VITE_PORT   (also usable in a plain browser)"
echo "    Dev bridge:  http://127.0.0.1:$BRIDGE_PORT  (engine over HTTP, debug builds only)"
echo "    Smoke tests: node scripts/ui-smoke.mjs '<steps>'"
echo "    Stop with Ctrl-C."
exec npm run tauri dev
