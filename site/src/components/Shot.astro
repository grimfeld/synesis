---
// A screenshot of the app in the page's language, light or dark to match the
// visitor's setting. Made by scripts/site-screenshots.mjs.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  lang: string;
  alt: string;
  /** The widest the picture is shown, in CSS pixels. */
  width: number;
  class?: string;
  eager?: boolean;
}
const { name, lang, alt, width, class: cls = "", eager = false } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>("../assets/screens/*.webp", { eager: true });
const pick = (theme: string) => {
  const f = files[`../assets/screens/${name}.${lang}.${theme}.webp`];
  if (!f) throw new Error(`no screenshot ${name}.${lang}.${theme}; run scripts/site-screenshots.mjs`);
  return f.default;
};
const widths = [Math.round(width / 2), width, Math.min(width * 2, 1600)];
const sizes = `(min-width: ${width + 64}px) ${width}px, calc(100vw - 2rem)`;
const [light, dark] = await Promise.all(
  [pick("light"), pick("dark")].map((src) => getImage({ src, widths, sizes, format: "webp" })),
);
const ratio = pick("light").height / pick("light").width;
---

<picture class={cls}>
  <source media="(prefers-color-scheme: dark)" srcset={dark.srcSet.attribute} sizes={sizes} type="image/webp" />
  <img
    src={light.src}
    srcset={light.srcSet.attribute}
    sizes={sizes}
    alt={alt}
    width={width}
    height={Math.round(width * ratio)}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
    decoding="async"
    class="block h-auto w-full rounded-xl border border-border shadow-[0_18px_50px_-24px_rgb(0_0_0/0.35)]"
  />
</picture>
